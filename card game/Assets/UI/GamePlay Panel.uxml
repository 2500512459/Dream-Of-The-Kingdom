<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/GamePlayUSS.uss?fileID=7433441132597879392&amp;guid=df22c61aac6600d4e933384b10ffe138&amp;type=3#GamePlayUSS" />
    <engine:VisualElement name="Base" style="flex-grow: 1; -unity-font-style: normal;">
        <engine:VisualElement name="Top" picking-mode="Ignore" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Art/UI%20Elements/bg_top.png?fileID=2800000&amp;guid=52d5bcb810af94ed4ab2923f96e1bfed&amp;type=3#bg_top&quot;); -unity-background-scale-mode: scale-to-fit; height: 80px;">
            <engine:Label text="玩家回合" picking-mode="Ignore" name="TurnLabel" select-word-by-double-click="false" style="-unity-text-align: middle-center; font-size: 45px; -unity-font-style: bold; color: rgb(255, 255, 255);" />
        </engine:VisualElement>
        <engine:VisualElement picking-mode="Ignore" style="flex-grow: 1; position: absolute; height: 267px; width: 216px; top: auto; left: 37px; bottom: 40px;">
            <engine:VisualElement name="Energy" picking-mode="Ignore" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Art/UI%20Elements/btn_energy.png?fileID=2800000&amp;guid=70b6e79c193014194b410a008e51f72c&amp;type=3#btn_energy&quot;); -unity-background-scale-mode: scale-to-fit; justify-content: center; width: 128px; height: 128px;">
                <engine:Label text="3" name="EnergyAmount" picking-mode="Ignore" select-line-by-triple-click="false" select-word-by-double-click="false" style="-unity-text-align: middle-right; font-size: 50px; right: 20px; -unity-font-style: bold-and-italic; color: rgb(46, 172, 224); height: 128px;" />
            </engine:VisualElement>
            <engine:VisualElement name="DrawDeck" picking-mode="Ignore" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Art/UI%20Elements/btn_handcards.png?fileID=2800000&amp;guid=3388a6609e5f941f7bfb3fb2a8e419ac&amp;type=3#btn_handcards&quot;); -unity-background-scale-mode: scale-to-fit; justify-content: center; width: 128px; height: 128px;">
                <engine:Label text="3" name="DrawAmount" picking-mode="Ignore" select-line-by-triple-click="false" select-word-by-double-click="false" style="-unity-text-align: middle-right; font-size: 60px; right: 20px; -unity-font-style: bold-and-italic; color: rgb(124, 218, 93);" />
            </engine:VisualElement>
            <engine:VisualElement name="Discard" picking-mode="Ignore" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Art/UI%20Elements/btn_discard.png?fileID=2800000&amp;guid=1afe153a33a5f490fb3daa334057b3f5&amp;type=3#btn_discard&quot;); -unity-background-scale-mode: scale-to-fit; justify-content: center; width: 128px; height: 128px;">
                <engine:Label text="3" name="DiscardAmount" picking-mode="Ignore" select-line-by-triple-click="false" select-word-by-double-click="false" style="-unity-text-align: middle-right; font-size: 50px; right: 20px; -unity-font-style: bold-and-italic; color: rgb(255, 147, 171);" />
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:Button name="EndTurn" class="turnbutten" style="position: absolute; top: 796px; left: 1618px; background-image: url(&quot;project://database/Assets/Art/UI%20Elements/btn_changeturn.png?fileID=2800000&amp;guid=d748cc1d815384abab73a835254b40f6&amp;type=3#btn_changeturn&quot;); -unity-background-scale-mode: scale-to-fit; background-color: rgba(188, 188, 188, 0); height: 179px; width: 222px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; transition-duration: 0.2s; transition-timing-function: ease-in-out-back;" />
    </engine:VisualElement>
</engine:UXML>
